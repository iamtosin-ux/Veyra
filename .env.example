# Copy to .env.local and fill in. Never commit .env.local.

# Required: signs session cookies (32+ random characters).
SESSION_SECRET=

# Required for AI analysis (server-side only; never exposed to the browser).
ANTHROPIC_API_KEY=

# Optional
