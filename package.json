{
  "name": "evidence-intel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"next dev\" \"npm:worker\"",
    "dev:web": "next dev",
    "worker": "tsx scripts/worker.mts",
    "build": "next build",
    "start": "concurrently -k -n web,worker \"next start\" \"npm:worker\"",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sample": "tsx scripts/make-sample-case.mts",
    "set-login": "tsx scripts/set-login.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@gitlab/fonts": "1.3.1",
    "@gitlab/svgs": "3.171.0",
    "@huggingface/transformers": "^4.3.1",
    "@internationalized/date": "^3.12.4",
    "@remixicon/react": "^4.9.0",
    "border-beam": "^1.4.1",
    "docx": "^9.13.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "mammoth": "^1.13.0",
    "motion": "^12.43.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
